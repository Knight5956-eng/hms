# Runtime Configuration
NODE_ENV=production
PORT=3000

# Database Configuration (Neon PostgreSQL)
# Example Neon connection string with SSL mode enabled:
# postgresql://<user>:<password>@<neon-hostname>.neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Redis Configuration (Upstash / Render Redis)
REDIS_URL=redis://default:password@sample-redis.upstash.io:6379

# Authentication Secrets
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=your-super-secret-jwt-refresh-key-at-least-32-chars
JWT_REFRESH_TTL=7d

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=https://hms.onrender.com,http://localhost:5173

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=hms-health-app
FCM_CLIENT_EMAIL=firebase-adminsdk@hms-health-app.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# SMS Provider (Africa's Talking)
AT_USERNAME=hms_kenya
AT_API_KEY=atsk_your_africas_talking_api_key_here
AT_SENDER_ID=EMBU_HOSP

# Email SMTP Provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key_here
MAIL_FROM=notifications@embuhospital.or.ke

# WebRTC Coturn / TURN Configuration
TURN_URLS=stun:stun.l.google.com:19302
TURN_SECRET=hms-turn-shared-secret-key

# Export Link Config
EXPORT_LINK_TTL_MINUTES=60
